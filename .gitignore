# 依赖
node_modules/
.pnpm-store/

# 构建输出
dist/
dist-ssr/
*.local
coverage/
*.tsbuildinfo

# 测试产物
test-results/
playwright-report/
blob-report/
.playwright/

# 内核构建产物：属于构建输出，不入库。
# 它们是 PluotSorbet（GPL-2.0）的衍生作品，按发布策略单独处理；
# 重建方式见 scripts/README.md。
public/kernel/

# 内核构建中间物
.work/
vendor/

# 验证用的 JAR 不入库。
# 放进去的通常是随手拿来的程序包，来源与授权都没登记过 —— 一旦提交，
# 「不收录任何缺授权的商业作品」这条就成了空话。要随包分发游戏时，
# 按 docs/SOURCE_AUDIT.md 的流程登记来源与授权，再单独放行。
public/assets/*.jar

# 环境与密钥
.env
.env.*
!.env.example

# 编辑器与系统
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
