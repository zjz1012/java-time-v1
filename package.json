{
  "name": "java-time-v1",
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "private": true,
  "description": "网页版 J2ME（MIDlet）运行与管理工具，移动端优先",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:kernels": "node scripts/check-kernel-artifacts.mjs",
    "check:games": "node scripts/import-games.mjs --check",
    "verify:e2e-report": "node scripts/verify-e2e-report.mjs",
    "build:midlets": "node scripts/build-midlets.mjs --install",
    "check:midlets": "node scripts/build-midlets.mjs --structural",
    "verify:midlets": "node scripts/build-midlets.mjs",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
